/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:

    void find(TreeNode * root , int& ans , int num)
    {
        if(root == nullptr)
        return ;
        
        num *= 10;
        num += root->val; 

        if(!root->left && !root->right)
        {
            ans += num;
            return;
        }

        find(root->left , ans , num);
        find(root->right , ans  , num);

        num /= 10;
    }
    int sumNumbers(TreeNode* root) {
        
        int ans = 0;
        int num = 0;

        find(root , ans , num);
        return ans;
    }
};
